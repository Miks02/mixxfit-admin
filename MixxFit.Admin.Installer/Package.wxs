<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="MixxFit Admin"
           Manufacturer="MixxFit"
           Version="$(var.ProductVersion)"
           UpgradeCode="2B36FF42-3AE4-4C9E-8C99-263577D12063"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(var.AppDir)MixxFit-CircleLogo.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ManufacturerFolder" Name="MixxFit">
        <Directory Id="INSTALLFOLDER" Name="MixxFit Admin" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="MixxFit Admin" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="AppExe">
        <File Id="AppExe" Source="$(var.PublishDir)Mixxfit.Admin.exe" KeyPath="yes" />
      </Component>
      <Files Include="$(var.PublishDir)**">
        <Exclude Files="$(var.PublishDir)Mixxfit.Admin.exe" />
        <Exclude Files="$(var.PublishDir)**\*.pdb" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts">
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
        <Shortcut Id="StartMenuShortcut"
                  Name="MixxFit Admin"
                  Description="MixxFit administration tool"
                  Target="[INSTALLFOLDER]Mixxfit.Admin.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\MixxFit\MixxFit Admin" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcut" Directory="DesktopFolder">
        <Shortcut Id="DesktopShortcut"
                  Name="MixxFit Admin"
                  Description="MixxFit administration tool"
                  Target="[INSTALLFOLDER]Mixxfit.Admin.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\MixxFit\MixxFit Admin" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="99" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="99" />
    </UI>

  </Package>
</Wix>
